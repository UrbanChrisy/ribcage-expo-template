{
	"name": "ribcage",
	"version": "1.0.0",
	"main": "./src/index.ts",
	"scripts": {
		"prebuild": "expo prebuild",
		"start": "expo start",
		"android": "expo run:android --device",
		"ios": "expo run:ios --device",
		"lint": "expo lint",
		"eas": "dotenv -e .env eas",
		"build:dev": "bun run eas workflow:run create-development-builds.yml",
		"build:prod": "bun run eas workflow:run create-production-builds.yml",
		"deploy:prod": "bun run eas workflow:run deploy-to-production.yml",
		"copy-websocket": "rm -rf modules/ribcage-react-native/src/clients/websocket && cp -r ../ribcage/packages/websocket modules/ribcage-react-native/src/clients/websocket",
		"postinstall": "bun run copy-websocket"
	},
	"dependencies": {
		"@expo/vector-icons": "^14.1.0",
		"@react-navigation/drawer": "^7.3.9",
		"@ribcage/expo-performance": "^1.0.2",
		"@rn-primitives/slot": "^1.2.0",
		"class-variance-authority": "^0.7.1",
		"expo": "53.0.22",
		"expo-constants": "~17.1.4",
		"expo-haptics": "^14.1.4",
		"expo-linking": "~7.1.4",
		"expo-router": "^5.1.4",
		"expo-splash-screen": "~0.30.7",
		"expo-status-bar": "~2.2.3",
		"nativewind": "^4.1.23",
		"react": "19.0.0",
		"react-dom": "19.0.0",
		"react-native": "0.79.6",
		"react-native-gesture-handler": "~2.24.0",
		"react-native-quick-crypto": "^0.7.17",
		"react-native-reanimated": "~3.17.4",
		"react-native-safe-area-context": "5.4.0",
		"react-native-screens": "~4.11.1",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^3.4.17",
		"zod": "^4.1.3"
	},
	"devDependencies": {
		"@babel/core": "^7.20.0",
		"@types/react": "~19.0.10",
		"dotenv-cli": "^8.0.0",
		"eslint": "^9.0.0",
		"eslint-config-expo": "~9.2.0",
		"prettier-plugin-tailwindcss": "^0.5.11",
		"typescript": "~5.8.3"
	},
	"private": true,
	"packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
